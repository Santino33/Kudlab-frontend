{
  "name": "kudlab-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck",
    "test:auth": "node --test tests/auth/*.test.mjs",
    "test:usuarios": "node --test tests/usuarios/*.test.mjs",
    "test:tareas": "node --test tests/tareas/*.test.mjs",
    "test:estudiantes": "node --test tests/academico/*.test.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-headers.mjs",
    "preview": "vite preview",
    "docker:setup": "node scripts/setup-docker.mjs",
    "docker:up": "docker --context desktop-linux compose --env-file .env.docker up --build -d --wait",
    "docker:down": "docker --context desktop-linux compose --env-file .env.docker down",
    "docker:status": "docker --context desktop-linux compose --env-file .env.docker ps",
    "test:docker": "node --test tests/docker/*.test.mjs",
    "docker:check": "node --test tests/docker/*.smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
